        "title": "Ошибка с расширенной расшифровкой",
        "inputState": {
          "root": "[M] PaymentControl",
          "State": "ErrorFilled",
          "focused": true,
          "systemNumericKeyboardOpen": true,
          "hint": "Превышен лимит операции",
          "infoIconVisible": true,
          "infoIconAction": {
            "interactionModel": "mobile Tooltip",
            "opens": "[M] BottomSheet"
          },
          "fullerExplanationRequired": true
