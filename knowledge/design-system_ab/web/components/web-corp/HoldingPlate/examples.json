          "holdingMode": true,
          "companyScope": "single",
          "additionalCompanyIdentificationRequired": true,
          "component": "🔒 HoldingPlate"
        },
        "expectedAudit": {
          "category": "none"
        }
      },
      {
        "exampleId": "holding-plate.invalid-multi-company-context",
        "title": "Плашка добавлена в общий multi-company контекст",
