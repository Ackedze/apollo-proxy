    "assemblyPolicy": {
      "workflow": "detached-rows-with-library-cells",
      "headerRow": "[D] HeadRow :: Universal",
      "bodyRow": "[D] BodyRow :: Wide",
      "designerSteps": [
        "Добавить [D] HeadRow :: Universal и [D] BodyRow :: Wide.",
        "Детачить строки.",
        "Добавить нужные библиотечные ячейки из [D] HeadCells :: Universal и [D] BodyCells :: Wide.",
        "Подобрать ширину каждой ячейки в detached-композиции."
      ],
      "requiredSurroundingComponents": [
        "[D] TopBar (sibling Level-0)",
        "HeaderRow",
        "BodyRow",
        "[D] StickyPagination",
        "[D] BackgroundPlateSlot"
      ],
      "unrelatedComponents": [
        "TableView"
      ],
      "placementPolicy": {
        "topBarAndPlate": "siblings-in-common-level-0-parent",
        "topBarInsideBackgroundPlateSlot": false,
        "tablePartsInsidePlateSlot": [
          "[D] HeadRow :: Universal",
          "[D] BodyRow :: Wide",
          "[D] StickyPagination"
        ]
      }
    },
    "usagePolicy": {
      "cellTextSlots": 1,
      "supportsHorizontalScroll": true,
      "supportsManyColumns": true,
      "supportsGrouping": true,
      "maxGroupingLevels": 1
    },
    "geometryPolicy": {
      "rowHeight": "effective-baseline-only",
      "columnWidth": {
        "designerEditable": true,
        "userEditable": true,
        "headAndBodyMustMatch": true
      },
      "headCellTitle": {
        "whenColumnHasInteractiveControls": {
          "width": "FILL",
          "height": "HUG",
          "textTruncation": "ENDING"
        },
        "fixedHeightAfterWidthChange": false
      },
      "fixedWidthCells": [
        "[D] BodyControlCell :: Wide",
        "[D] BodyActionCell :: Wide",
        "[D] HeadActionCell",
        "[D] HeadControlCell"
      ]
    },
    "statePolicy": {
      "sorting": {
        "enabledByContext": true,
        "maxActiveColumns": 1,
        "initialState": "product-defined"
      },
      "skeleton": {
        "defaultScope": "whole-table",
        "partialRowOrCellLoadingAllowed": true
      }
    },
    "interactionPolicy": {
      "wholeRowClickable": true,
      "selectAllScope": "current-page",
      "headControlRequiredWhenSelectable": true,
      "rowActionFlow": {
        "requiresVisibleEntryState": true,
        "entryState": "active menu or popover anchored to the row ActionButton and listing the named action",
        "bareActionButtonIsInsufficient": true,
        "requiredStates": [
          "entry-action-menu",
          "confirmation",
          "post-action-result"
        ],
        "postActionState": "must visibly reflect the completed mutation or a system result; a duplicate of the entry state is invalid",
        "componentPolicy": "Use an active library menu/popover discovered from agent-context; do not hand-draw the action menu."
      }
    },
    "columnControlPolicy": {
      "required": true,
      "interactiveColumnMinWidth": 160,
      "pinningAllowed": true,
      "pinningAllColumnsEqualsNoPinning": true,
      "sortingActionsVisibleOnlyForSortableColumns": true
    },
    "bottomBlockPolicy": {
      "component": "[D] StickyPagination",
      "alwaysPresent": true,
      "singlePagePreset": "None",
      "selectedRowsPreset": "BulkActions",
      "stickyOnVerticalOverflow": true,
      "lastBodyRowDivider": false,
      "bulkActions": {
        "standaloneTableBulkActionsAllowed": false,
        "maxActionButtons": 4,
        "actions": "context-dependent for selected rows"
      }
    },
    "actionCellPolicy": {
      "allowedContent": [
        "one Button",
        "PickerButton",
        "Presets=None"
      ],
      "arbitraryInstanceSwap": false
    },
    "contentPolicy": {
      "arbitraryInstanceSwap": false,
      "contentSelection": "component-supported presets only",
      "supportedPresetsAllowed": true,
      "emptyOrErrorState": {
        "component": "CorporateSystemMessage",
        "replaces": "BodyRow only",
        "preserves": [
          "[D] TopBar",
          "[D] HeadRow :: Universal",
          "[D] StickyPagination"
        ]
      }
    },
    "allowedLayerOverrides": [
      "characters",
      "alignment in HeadCell and BodyCell",
      "width of ordinary HeadCell and matching BodyCell"
    ],
