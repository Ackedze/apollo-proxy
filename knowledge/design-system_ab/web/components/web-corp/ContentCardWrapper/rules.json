          "schemaVersion": "apollo.contour-definition.v1",
          "kind": "baseline-set",
          "select": {
            "from": "selection-root",
            "traverse": "self-and-descendants",
            "where": [
              {
                "predicate": "one-of",
                "actual": {
                  "fact": "type"
                },
                "expected": {
                  "literal": [
                    "INSTANCE",
                    "FRAME",
                    "RECTANGLE",
                    "ELLIPSE"
                  ]
                }
              },
              {
                "predicate": "equals",
                "actual": {
                  "fact": "visible"
                },
                "expected": {
                  "literal": true
                }
              },
              {
                "predicate": "equals",
                "actual": {
                  "fact": "ownership.contour.root.component.family"
                },
                "expected": {
                  "literal": "content-card-wrapper"
                }
              }
            ]
          },
          "paths": [
            {
              "suffix": "fill",
              "label": "Заливка",
              "actualFact": "appearance.fill.value",
              "baselineFact": "baseline.effective.appearance.fill.value"
            },
            {
              "suffix": "stroke",
              "label": "Обводка",
              "actualFact": "appearance.stroke.value",
              "baselineFact": "baseline.effective.appearance.stroke.value"
            },
            {
              "suffix": "radius",
              "label": "Скругление",
              "actualFact": "appearance.radius",
              "baselineFact": "baseline.effective.appearance.radius"
            },
            {
              "suffix": "opacity",
              "label": "Прозрачность",
              "actualFact": "appearance.opacity",
              "baselineFact": "baseline.effective.appearance.opacity"
            }
          ],
