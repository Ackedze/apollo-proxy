            "expectation": "{{property}} должен совпадать с effective baseline текущего ContentCardWrapper.",
            "action": "Сбросить {{property}} слоя «{{targetName}}» к effective baseline."
          },
          "scope": {
            "platform": [
              "desktop",
              "mobile-web"
            ]
          },
          "unknownPolicy": "not-evaluable"
        }
