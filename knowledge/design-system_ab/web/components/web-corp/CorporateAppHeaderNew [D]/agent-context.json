  "manual": {
    "componentSemantics": [
      {
        "componentKey": "d187029a0a1af08dbb499e13b3ef2ac98efaaac2",
        "name": "[D] Header",
        "purpose": "Верхняя навигационная панель корпоративной страницы с системными действиями, переключением компании и доступом к профилю.",
        "useWhen": [
          "Собирается корпоративная desktop-страница на ширине 768 px и выше."
        ],
        "doNotUseWhen": [
          "Компонент используется без соответствующей боковой навигации или вне корпоративной оболочки."
        ],
        "relationship": "Обязательная верхняя часть CorporateAppHeaderNew; на больших разрешениях работает с SideMenu, на 768 px — с HeaderMenu.",
        "status": "approved",
        "provenance": "design-system-author"
      },
      {
        "componentKey": "379ded7ba661ce24eaedeb43cf38f117fd89be96",
        "name": "[D] SideMenu",
        "purpose": "Постоянная боковая навигация по продуктам и разделам корпоративного desktop-интерфейса.",
        "useWhen": [
          "На большом desktop-разрешении нужно постоянно показывать основную корпоративную навигацию."
        ],
        "doNotUseWhen": [
          "Макет находится на ширине 768 px, где SideMenu заменяется HeaderMenu."
        ],
        "relationship": "Desktop-компаньон [D] Header; использует общую с HeaderMenu модель пунктов и активного состояния.",
        "status": "approved",
        "provenance": "design-system-author"
      },
      {
        "componentKey": "18afe356fff5b5b7dee60e2d65c83ff7c0d4abb3",
        "name": "[D](768) HeaderMenu",
        "purpose": "Выдвижное навигационное меню для корпоративной страницы на ширине 768 px.",
        "useWhen": [
          "На breakpoint 768 px функции SideMenu нужно открыть в левом drawer."
        ],
        "doNotUseWhen": [
          "Доступно достаточно места для постоянного SideMenu."
        ],
        "relationship": "Адаптивная замена SideMenu при [D] Header с состоянием Tablet=true.",
        "status": "approved",
        "provenance": "design-system-author"
      }
    ],
    "summary": {
      "componentFamily": "CorporateAppHeaderNew [D]",
      "library": "Web _ Corp Components",
      "purpose": "Обязательная desktop-навигационная оболочка корпоративной страницы. На больших разрешениях она состоит из [D] Header и [D] SideMenu. На ширине 768 px Header остаётся в состоянии 👽 Tablet=true, а SideMenu заменяется компонентом [D](768) HeaderMenu, который открывается слева как drawer. Header также даёт доступ к письмам, уведомлениям, переключению компании или группы, выбору доступной роли, выходу и возврату по истории."
    },
    "manualContext": {
      "publicComponents": [
        "[D] Header",
        "[D] SideMenu",
        "[D](768) HeaderMenu"
      ],
      "standaloneUsageAllowed": false,
      "breakpoints": {
        "768": "[D] Header with 👽 Tablet=true + optional opened [D](768) HeaderMenu drawer",
        "largeDesktop": "[D] Header + [D] SideMenu"
      },
      "allowedDesignerOverrides": [
        "Back",
        "Edit Mode",
        "CompanyAccount Holding",
        "company logo/name/user name",
        "product item label/icon/composition",
        "Mail and Notifications unread count up to 99+"
      ],
      "forbiddenDesignerChanges": [
        "manual 👽 Tablet change",
        "detach",
        "LogoCell replacement or hiding",
        "AllServices or Bonus content changes",
        "system control swaps",
        "manual visual or layout changes"
      ],
      "navigationModel": {
        "synchronizedBetween": [
          "[D] SideMenu",
          "[D](768) HeaderMenu"
        ],
        "singleActiveItem": true,
        "maxNestingDepth": 1,
        "products": "user-visible products with personalized order and visibility",
        "recommended": "required promo offers with fixed order",
        "footer": "pinned settings entry",
        "scrollRegion": "Cells only"
      }
    },
    "auditInterpretation": {
      "componentProperties": [
        "variant.*"
      ],
      "layerProperties": [
        "fill",
        "stroke",
        "styles.text",
        "layout.*",
        "radius",
        "opacity"
      ],
      "baselinePolicy": "Сравнивай изменения layer с effective baseline текущего состояния компонента, если доступен host composition context. Back и Edit Mode являются разрешёнными контекстными параметрами; ручное изменение 👽 Tablet запрещено. Структура Header, набор Mail/Notifications, аватар и роль неизменяемы. Логотип компании, название компании или группы, имя пользователя, названия и иконки продуктовых пунктов являются контекстными overrides. SideMenu и HeaderMenu синхронизированы: Products следуют персональным настройкам, Reccomended фиксирован, Footer закреплён снизу, вложенность ограничена одним уровнем. Геометрия, visual и layout styles не редактируются вручную; прокручивается только область Cells. LogoCell обязателен и неизменяем. Edit Mode управляет только порядком и видимостью, применяет изменения сразу и не имеет сброса. Drawer закрывается только кнопкой Close. Detach запрещён. Текст остаётся однострочным с fade, рекомендуемая длина — 16 символов; непрочитанные события ограничиваются значением 99+."
    }
  }
}
