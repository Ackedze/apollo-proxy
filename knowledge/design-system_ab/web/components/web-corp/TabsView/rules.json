        "checkType": "manual",
        "matchKind": "exact_component_rule",
        "requiredParity": [
          "labels",
          "order",
          "tabCount"
        ],
        "ruleText": "Desktop и mobile-web версии TabsView должны иметь одинаковые названия, порядок и количество табов.",
