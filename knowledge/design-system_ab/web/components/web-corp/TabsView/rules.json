      {
        "ruleId": "component:web-corp.tabs-view.manual-visual-overrides-forbidden",
        "severity": "error",
        "source": "component-contract",
        "appliesTo": "layout.*|divider|styles.text|typography|fill|stroke|stroke.*|radius|opacity",
        "checkType": "deterministic",
        "matchKind": "exact_component_rule",
        "ruleText": "В TabsView запрещено вручную менять spacing, padding, divider, типографику, заливки, обводки, скругления и opacity. Используй effective baseline компонента.",
        "ruleKind": "design-rule",
        "authority": {
          "status": "active",
          "provenance": "design-system-author",
          "revision": 2
        },
        "predicateContour": {
          "schemaVersion": "apollo.contour-definition.v1",
          "kind": "baseline",
          "select": {
            "from": "selection-root",
            "traverse": "self-and-descendants",
            "where": [
              {
                "predicate": "equals",
                "actual": {
                  "fact": "ownership.owner.component.identity"
                },
                "expected": {
                  "literal": "web-corp.tabs-view"
                }
              },
              {
                "predicate": "exists",
                "actual": {
                  "fact": "appearance.stroke.value"
                }
              }
            ]
          },
          "pairs": [
            {
              "actualFact": "appearance.stroke.value",
              "baselineFact": "baseline.effective.appearance.stroke.value",
              "required": true
            }
          ],
          "presentation": {
            "schemaVersion": "apollo.predicate-presentation.v1",
            "title": "Изменена обводка TabsView",
            "observed": "Обводка изменена с {{expected}} на {{actual}}.",
            "expectation": "Обводки TabsView должны совпадать с effective baseline выбранного варианта.",
            "action": "Сбросить обводку к effective baseline TabsView.",
            "targetFact": "appearance.stroke.value"
          },
          "scope": {
            "platform": [
              "desktop",
              "mobile-web"
            ]
          },
          "unknownPolicy": "not-evaluable"
        }
      },
