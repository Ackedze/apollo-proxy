        "ruleId": "component:web-corp.tabs-view.platform-overflow-behavior",
        "severity": "error",
        "source": "component-contract",
        "appliesTo": "component.visibility|interaction",
        "checkType": "manual",
        "matchKind": "exact_component_rule",
