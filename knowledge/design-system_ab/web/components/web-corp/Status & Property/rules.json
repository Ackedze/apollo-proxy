        "ruleId": "component:web-corp.status-property.label-is-required",
        "severity": "error",
        "ruleKind": "design-rule",
        "severityScope": "design",
        "source": "component-contract",
        "appliesTo": "component.visibility|text",
        "checkType": "deterministic",
        "matchKind": "composition_rule",
        "required": {
          "Label.visible": true,
          "Label.text": "non-empty"
        },
        "classification": {
          "treatAsViolation": true,
          "designSeverity": "error"
        },
        "ruleText": "Label обязателен в StatusPreset и PropertyPreset. Нельзя скрывать Label или оставлять только LeftAddon без текста.",
        "authority": {
          "status": "active",
          "provenance": "design-system-author",
          "revision": 1
        },
        "predicateContour": {
          "schemaVersion": "apollo.contour-definition.v1",
          "kind": "query-count",
          "select": {
            "from": "selection-root",
            "traverse": "self-and-descendants",
            "where": [
              { "predicate": "equals", "actual": { "fact": "type" }, "expected": { "literal": "INSTANCE" } },
              { "predicate": "equals", "actual": { "fact": "component.identity" }, "expected": { "literal": "web-corp.status-property" } },
              { "predicate": "one-of", "actual": { "fact": "component.family" }, "expected": { "literal": ["status-preset", "property-preset"] } }
            ]
          },
          "query": {
            "from": "subject",
            "traverse": "descendants",
            "where": [
              { "predicate": "equals", "actual": { "fact": "type" }, "expected": { "literal": "TEXT" } },
              { "predicate": "equals", "actual": { "fact": "name" }, "expected": { "literal": "Label" } },
              { "predicate": "equals", "actual": { "fact": "visible" }, "expected": { "literal": true } },
              { "predicate": "compare", "actual": { "fact": "text.length" }, "expected": { "literal": 0 }, "operator": "gt" }
            ]
          },
          "lower": 1,
          "upper": 1,
          "presentation": {
            "schemaVersion": "apollo.predicate-presentation.v1",
            "title": "В preset отсутствует обязательный Label",
            "observed": "Найдено видимых непустых Label: {{actual}}.",
            "expectation": "StatusPreset и PropertyPreset должны содержать один видимый непустой Label.",
            "action": "Показать Label и задать ему текст."
          },
          "scope": { "platform": ["desktop", "mobile-web"] },
          "unknownPolicy": "not-evaluable"
        }
      },
