          "Primary",
          "Secondary"
        ],
        "allowedButtonCombinations": [
          [
            "Primary",
            "Secondary"
          ],
          [
            "Secondary",
            "Transparent"
          ]
        ],
        "buttonSizes": {
          "desktop": 48,
