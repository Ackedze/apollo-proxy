    "compositionPolicy": {
      "purpose": "Визуальное представление отдельного промопредложения, преимущества или акции с выразительным сочетанием текста и изображения.",
      "platforms": {
        "[D] PromoCard": "desktop at viewport width 768 px or greater",
        "[M] PromoCard": "mobile-web below 768 px"
      },
      "sizes": {
        "allowed": [
          "Small",
          "Medium",
          "Large"
        ],
        "selectionPolicy": "according to composition"
      },
      "requiredContent": [
        "Title"
      ],
      "optionalContent": [
        "Subtitle",
        "Image",
        "BottomContent"
      ],
      "contentLimits": {
        "Title": {
          "maximumCharacters": 60,
          "maximumLines": 2
        },
        "Subtitle": {
          "maximumCharacters": 120,
          "maximumLines": 3
        }
      },
      "image": {
        "required": false,
        "noneAllowed": true,
        "noneUseCase": "only in a bento grid",
        "allowedPositions": [
          "Top",
          "Bottom"
        ],
        "imageCropMayChange": true,
        "offset": {
          "purpose": "image extends beyond the [Promo] BackgroundPlate bounds",
