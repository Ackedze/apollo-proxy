        "verticalAxisRecommendedWhen": "ContentWrapper.Centred=True",
        "clickableCardAndButtonMayCoexist": true,
        "coexistingCardAndButtonAction": "the button duplicates the card action",
        "differentActionException": "inline text link inside a text block may open an explanation or tooltip",
        "clickableCardWithTwoButtonsAllowed": false,
        "twoButtonActions": "each button may perform its own action"
      },
      "bottomContent": {
        "role": "open slot for context-specific content",
        "visibleWithoutButtons": true,
        "instanceSwapAllowed": true,
