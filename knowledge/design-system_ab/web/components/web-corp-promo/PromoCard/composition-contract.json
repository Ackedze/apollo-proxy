          "mayCombineWithImageCrop": true
        },
        "noneState": {
          "ImageCrop": false,
          "Offset": false
        },
        "replacementTarget": "ImageView",
        "sourceLibrary": "Corp :: Image Library",
        "sourceLibraryRequired": true,
        "ImageView": {
          "allowedOverrides": [
            "Segment"
          ],
          "cropControl": "PromoCard.ImageCrop",
          "fixedByEffectiveBaseline": [
            "Crop",
            "Size",
            "all other properties"
          ]
        },
        "internalImageContainer": {
          "Image Centred": "not a public PromoCard property; keep at effective baseline"
        }
      },
      "contentWrapper": {
        "allowedTitleValues": [
          "Primary",
          "Secondary"
        ],
        "centredMayChange": true,
        "centredSelectionPolicy": "according to task context"
      },
      "interaction": {
        "entireCardMayBeClickable": true,
        "maximumButtons": 2,
