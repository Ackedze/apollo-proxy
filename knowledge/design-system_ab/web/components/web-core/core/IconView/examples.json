        "exampleId": "icon-view.public-root-pass",
        "title": "Published IconView is used as a public root",
        "inputChange": {
          "node": "IconView",
          "property": "component.identity",
          "referenceValue": "web-core.icon-view/icon-view",
          "actualValue": "web-core.icon-view/icon-view"
        },
        "expectedAudit": {
          "ruleId": "component:web-core.icon-view.public-root-only",
          "classification": "compliant",
          "focus": "IconView"
        }
      },
      {
        "exampleId": "icon-view.internal-content-root-fail",
        "title": "Internal Content is placed as a standalone component",
        "inputChange": {
          "node": "Content",
          "property": "component.family",
          "referenceValue": "icon-view",
          "actualValue": "content"
        },
        "expectedAudit": {
          "ruleId": "component:web-core.icon-view.public-root-only",
          "classification": "violation",
          "focus": "Content"
        }
      },
      {
        "exampleId": "icon-view.radius-baseline-fail",
        "title": "IconView radius is changed manually",
        "inputChange": {
