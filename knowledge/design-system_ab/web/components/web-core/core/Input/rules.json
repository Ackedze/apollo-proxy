  "generated": {
    "rules": [
      {
        "ruleId": "component:web-core.input.component-properties-are-first-class",
        "severity": "info",
        "source": "component-contract",
        "appliesTo": "variant.*",
        "checkType": "deterministic",
        "matchKind": "exact_component_rule",
        "target": {
          "component": "Input",
          "layers": [
            "[D] Input",
            "[D] Input_Inverted",
            "[D][Corporate] Input",
            "[D][Corporate] Input_Inverted",
            "[M] Input",
            "[M] Input_Inverted",
            "[M][AO] Input",
            "[M][AO] Input_Inverted",
            "🔄 [D][Corporate] Input",
            "🔄 [D][Corporate] Input_Inverted",
            "🔄 [M][AO] Input",
            "🔄 [M][AO] Input_Inverted",
            "Input"
          ]
        },
        "ruleText": "Изменения variant/property в этом семействе компонентов являются component-property customizations. Показывай их отдельно от производных визуальных изменений layer."
      },
      {
        "ruleId": "component:web-core.input.layer-properties-use-effective-baseline",
        "severity": "error",
        "source": "composition-contract",
        "appliesTo": "layout.*|styles.text|fill|stroke|radius|opacity",
        "checkType": "deterministic",
        "matchKind": "exact_component_rule",
        "target": {
          "component": "Input",
          "layers": [
            "[D] Input",
            "[D] Input_Inverted",
            "[D][Corporate] Input",
            "[D][Corporate] Input_Inverted",
            "[M] Input",
            "[M] Input_Inverted",
            "[M][AO] Input",
            "[M][AO] Input_Inverted",
            "🔄 [D][Corporate] Input",
            "🔄 [D][Corporate] Input_Inverted",
            "🔄 [M][AO] Input",
            "🔄 [M][AO] Input_Inverted",
            "Input"
          ]
        },
        "ruleText": "Layer/style свойства Core-компонента должны совпадать с effective baseline текущего component variant и nested owner context. Любое фактическое отклонение является нарушением, если отдельное approved правило явно не разрешает эту кастомизацию.",
        "ruleKind": "design-rule",
        "classification": {
          "treatAsViolation": true,
          "resetSurface": "layer"
        },
        "authority": {
          "status": "active",
          "provenance": "generated-policy",
          "revision": 1
        }
      }
    ]
