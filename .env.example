HOST=127.0.0.1
PORT=3001
APOLLO_AGENT_URL=https://aiflowteam3.aiflow-test.moscow.alfaintra.net/api/v1/run/f89d7dbf-8602-4495-8735-952e0ac2028b
APOLLO_AGENT_KEY=

APOLLO_AGENT_INSECURE_TLS=1

# Codex backend used by Apollo v2 validation and Apollo v3 report analysis.
# The bundled Codex CLI from ChatGPT.app is discovered automatically on macOS.
CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
CODEX_MODEL=
# Apollo v3 report analysis: packet (default), skill or prompt (A/B modes).
APOLLO_CODEX_REPORT_STRATEGY=packet
# Knowledge used to resolve Apollo v3 packet: ds-ai-hub (default) or design-system_ab.
APOLLO_CODEX_KNOWLEDGE_SOURCE=ds-ai-hub
# Таймаут бездействия сбрасывается при каждом stdout/stderr событии Codex.
CODEX_IDLE_TIMEOUT_MS=300000
# Жёсткий верхний предел одного аудита.
CODEX_MAX_RUNTIME_MS=900000
# Deprecated alias for CODEX_IDLE_TIMEOUT_MS:
# CODEX_TIMEOUT_MS=300000
CODEX_RUN_TTL_MS=600000
CODEX_WORKSPACE=
# Локальные debug-артефакты pattern/text прогонов. По умолчанию включены и
# сохраняются в CODEX_WORKSPACE/debug-runs/<runId>/.
APOLLO_CODEX_DEBUG_ENABLED=1
APOLLO_CODEX_DEBUG_ROOT=
# Предупреждение и безопасный предел длины prompt до запуска Codex.
APOLLO_CODEX_INPUT_WARN_CHARS=700000
APOLLO_CODEX_INPUT_BUDGET_CHARS=900000
CODEX_DS_AI_HUB=
CODEX_DESIGN_SYSTEM=
