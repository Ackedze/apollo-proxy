HOST=127.0.0.1
PORT=3001
APOLLO_AGENT_URL=https://aiflowteam3.aiflow-test.moscow.alfaintra.net/api/v1/run/f89d7dbf-8602-4495-8735-952e0ac2028b
APOLLO_AGENT_KEY=

APOLLO_AGENT_INSECURE_TLS=1

# Local CLI agent used by Apollo validation, report analysis and explanations.
# Select codex (default) or claude. Each CLI manages its own account sign-in.
APOLLO_CLI_PROVIDER=codex
# Claude Code 2.1.248+; auto-discovered in ~/.local/bin, Homebrew and PATH.
CLAUDE_BIN=
CLAUDE_MODEL=
# Optional custom Claude account/config directory; no tokens are stored by Apollo.
CLAUDE_CONFIG_DIR=
# Codex backend.
# Discovered automatically in desktop apps, ~/.local/bin, Homebrew and PATH.
CODEX_BIN=
CODEX_MODEL=
# Apollo v3 report analysis: packet (default), skill or prompt (A/B modes).
APOLLO_CODEX_REPORT_STRATEGY=packet
# Knowledge used to resolve Apollo v3 packet: ds-ai-hub (default) or design-system_ab.
APOLLO_CODEX_KNOWLEDGE_SOURCE=ds-ai-hub
# Public stable descriptor stored in design-system_ab/main:
# APOLLO_KNOWLEDGE_DESCRIPTOR_URL=https://raw.githubusercontent.com/Ackedze/design-system_ab/main/apollo/knowledge/channels/stable.json
APOLLO_KNOWLEDGE_DESCRIPTOR_URL=
# Leave empty for the public design-system_ab repository. Reserved for a future private endpoint.
APOLLO_KNOWLEDGE_TOKEN=
# Unified knowledge + installed-contract data release. HTTPS channel descriptor.
# No publisher/Git write credential is needed on a consumer machine.
APOLLO_DATA_DESCRIPTOR_URL=
APOLLO_DATA_TOKEN=
# Optional per-user infrastructure. Configure using scripts/configure-portable.js.
APOLLO_FIGMA_FILE_KEY=
APOLLO_FRONTEND_TOOLCHAIN_ROOT=
APOLLO_CHROME_BIN=
# Таймаут бездействия сбрасывается при каждом stdout/stderr событии Codex.
CODEX_IDLE_TIMEOUT_MS=300000
# Жёсткий верхний предел одного аудита.
CODEX_MAX_RUNTIME_MS=900000
# Deprecated alias for CODEX_IDLE_TIMEOUT_MS:
# CODEX_TIMEOUT_MS=300000
CODEX_RUN_TTL_MS=600000
CODEX_WORKSPACE=
# Локальные debug-артефакты pattern/text прогонов. По умолчанию включены и
# сохраняются в CODEX_WORKSPACE/debug-runs/<runId>/.
APOLLO_CODEX_DEBUG_ENABLED=1
APOLLO_CODEX_DEBUG_ROOT=
# Предупреждение и безопасный предел длины prompt до запуска Codex.
APOLLO_CODEX_INPUT_WARN_CHARS=700000
APOLLO_CODEX_INPUT_BUDGET_CHARS=900000
# Pattern audit is split into component-contract, visual-bindings and
# layout-patterns passes over one frozen snapshot. Set single for A/B rollback.
APOLLO_CODEX_PATTERN_AUDIT_MODE=faceted
# Soft JSON budget of one faceted packet before recursive target chunking.
APOLLO_CODEX_PATTERN_PASS_BUDGET_CHARS=420000
CODEX_DS_AI_HUB=
CODEX_DESIGN_SYSTEM=

# Installed contract snapshot (kept outside source and history).
# APOLLO_DATA_ROOT=/installed/apollo-proxy/runtime/data
# APOLLO_PROJECT_ROOT=/installed/apollo-runtime
