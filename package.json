{
  "name": "apollo-proxy",
  "version": "1.4.0",
  "description": "Локальный прокси-сервер Apollo для корпоративного агента",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "data:import": "node scripts/import-data-package.js",
    "data:build-release": "node scripts/build-data-release.js",
    "data:update": "node scripts/data-release-cli.js",
    "runtime:build-portable": "node scripts/build-portable-runtime.js",
    "portable:configure": "node scripts/configure-portable.js",
    "skill:sync": "node scripts/sync-codex-skill.js",
    "knowledge:check": "node scripts/sync-contract-knowledge.js --check",
    "knowledge:build": "node scripts/build-knowledge-package.js",
    "knowledge:publish": "node scripts/publish-knowledge-package.js",
    "knowledge:test": "node --test test/knowledge-package.test.js",
    "predicate:migration-audit": "node scripts/audit-predicate-migration-wave.js",
    "prestart": "npm run skill:sync",
    "start": "node server.js",
    "test": "npm run skill:sync && npm run knowledge:check && node --test test/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  }
}
