{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apollo.local/schemas/apollo-knowledge-package-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentVersion", "channel", "engineCompatibility", "sourceCommits", "generatedAt", "projection", "artifactCount", "totalBytes", "artifacts", "checksum"],
  "properties": {
    "schemaVersion": { "const": "apollo.knowledge-package.v1" },
    "contentVersion": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$" },
    "channel": { "const": "stable" },
    "engineCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": { "min": { "type": "string" }, "max": { "type": "string" } }
    },
    "sourceCommits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design-system_ab", "ds-ai-hub"],
      "properties": {
        "design-system_ab": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "ds-ai-hub": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "projection": { "type": "object" },
    "artifactCount": { "type": "integer", "minimum": 1 },
    "totalBytes": { "type": "integer", "minimum": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^data/" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value", "integrity"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "integrity": { "type": "string", "pattern": "^sha256-" }
      }
    }
  }
}
