{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ackedze.github.io/apollo/schemas/apollo-rule-ir-v1.schema.json",
  "title": "Apollo RuleIR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "ruleId", "revision", "source", "authority", "effect",
    "scope", "select", "assert", "severity", "unknownPolicy"
  ],
  "properties": {
    "schemaVersion": { "const": "apollo.rule-ir.v1" },
    "ruleId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "checksum"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "checksum": { "type": "string", "minLength": 1 },
        "anchor": { "type": ["string", "null"] }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "provenance"],
      "properties": {
        "status": { "enum": ["active", "draft", "deprecated"] },
        "provenance": { "type": "string", "minLength": 1 }
      }
    },
    "effect": { "enum": ["require", "forbid", "allow"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "pageType": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "select": { "$ref": "#/$defs/selector" },
    "when": { "$ref": "#/$defs/expression" },
    "assert": { "$ref": "#/$defs/expression" },
    "severity": { "enum": ["error", "warning", "info"] },
    "unknownPolicy": { "enum": ["not-evaluable", "human-review"] },
    "remediation": { "type": ["object", "null"] }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "traverse"],
      "properties": {
        "from": { "enum": ["selection-root", "self", "page-descendants"] },
        "traverse": { "enum": ["self", "direct-children", "descendants", "self-and-descendants", "parent", "ancestors", "siblings"] },
        "where": { "type": "array", "items": { "$ref": "#/$defs/expression" } }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["literal"],
          "properties": { "literal": true }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fact"],
          "properties": { "fact": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["query"],
          "properties": {
            "query": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "traverse"],
              "properties": {
                "from": { "enum": ["subject", "selection-root", "page-descendants"] },
                "traverse": { "enum": ["self", "direct-children", "descendants", "self-and-descendants", "parent", "ancestors", "siblings"] },
                "where": { "type": "array", "items": { "$ref": "#/$defs/expression" } },
                "project": { "$ref": "#/$defs/value" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["derive"],
          "properties": {
            "derive": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operator", "args"],
              "properties": {
                "operator": { "enum": ["add", "subtract", "multiply", "divide", "length", "absolute-difference"] },
                "args": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/value" }
                }
              }
            }
          }
        }
      ]
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate"],
      "properties": {
        "predicate": { "type": "string", "minLength": 1 },
        "actual": { "$ref": "#/$defs/value" },
        "expected": { "$ref": "#/$defs/value" },
        "target": { "$ref": "#/$defs/value" },
        "lower": { "$ref": "#/$defs/value" },
        "upper": { "$ref": "#/$defs/value" },
        "operator": { "enum": ["lt", "lte", "gt", "gte"] },
        "bounds": { "enum": ["inclusive", "exclusive", "inclusive-lower", "inclusive-upper"] },
        "flags": { "type": "string", "pattern": "^[dgimsuvy]*$" },
        "axis": {
          "enum": [
            "left", "center-x", "right", "top", "center-y", "bottom",
            "horizontal", "vertical", "euclidean"
          ]
        },
        "tolerance": { "type": "number", "minimum": 0 },
        "positions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              { "enum": ["first", "last"] },
              { "type": "integer", "minimum": 0 }
            ]
          }
        },
        "maxCount": { "type": "integer", "minimum": 0 },
        "args": { "type": "array", "items": { "$ref": "#/$defs/expression" } }
      }
    }
  }
}
