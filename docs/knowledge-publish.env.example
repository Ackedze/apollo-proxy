# Copy this file to .env.knowledge-publish in the apollo-proxy repository.
# The publisher uses the existing `gh auth` session; no token is stored here.
APOLLO_KNOWLEDGE_GITHUB_REPOSITORY=Ackedze/design-system_ab
APOLLO_KNOWLEDGE_GITHUB_BRANCH=main

# Clean checkouts used as reproducible package inputs.
DESIGN_SYSTEM_AB_ROOT=/absolute/path/to/design-system_ab
DS_AI_HUB_ROOT=/absolute/path/to/ds-ai-hub
