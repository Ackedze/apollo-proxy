{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportId",
    "captureId",
    "sourcePin",
    "assessments"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "apollo.component-pattern-assessment.v2"
    },
    "reportId": {
      "type": "string"
    },
    "captureId": {
      "type": "string"
    },
    "sourcePin": {
      "type": "string"
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeId",
          "outcome",
          "observation",
          "reason",
          "evidenceNodeIds",
          "ruleIds",
          "ruleResults",
          "sourceRefs"
        ],
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "compliant",
              "violation",
              "insufficient-data",
              "not-applicable"
            ]
          },
          "observation": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "evidenceNodeIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 30
          },
          "ruleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "rule:components.progress-bar.goal-for-target-progress",
                "rule:components.progress-bar.limit-for-threshold",
                "rule:components.amount.monetary-values-only",
                "rule:components.amount.table-currency-not-duplicated",
                "rule:controls.buttons-and-button-groups.action-verb",
                "rule:controls.buttons-and-button-groups.icon-button-clear-context"
              ]
            },
            "minItems": 1,
            "maxItems": 2
          },
          "ruleResults": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ruleId",
                "outcome",
                "reason",
                "evidenceNodeIds"
              ],
              "properties": {
                "ruleId": {
                  "type": "string",
                  "enum": [
                    "rule:components.progress-bar.goal-for-target-progress",
                    "rule:components.progress-bar.limit-for-threshold",
                    "rule:components.amount.monetary-values-only",
                    "rule:components.amount.table-currency-not-duplicated",
                    "rule:controls.buttons-and-button-groups.action-verb",
                    "rule:controls.buttons-and-button-groups.icon-button-clear-context"
                  ]
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "compliant",
                    "violation",
                    "insufficient-data",
                    "not-applicable"
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "evidenceNodeIds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 30,
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "minItems": 1,
            "maxItems": 2
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceId",
                "sha256",
                "ruleId"
              ],
              "properties": {
                "sourceId": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "ruleId": {
                  "type": "string"
                }
              }
            },
            "minItems": 1,
            "maxItems": 2
          }
        }
      },
      "maxItems": 32
    }
  }
}
